{
  "files.exclude": {
    "**/node_modules": true,
    "**/artifacts": true,
    "**/cache": true,
    "**/cache_forge": true,
    "**/out": true,
    "**/types/ethers-contracts": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "lib": true,
    "**/node_modules": true,
    "**/artifacts": true,
    "**/cache": true,
    "**/cache_forge": true,
    "**/out": true,
    "**/types/ethers-contracts": true,
    "yarn.lock": true,
    ".openzeppelin/**": true
  },
  "files.watcherExclude": {
    "**/lib/**": true,
    "**/node_modules/**": true,
    "**/artifacts/**": true,
    "**/cache/**": true,
    "**/cache_forge/**": true,
    "**/out/**": true,
    "**/types/ethers-contracts/**": true
  },

  // Solidity (JuanBlanco extension)
  "solidity.compileUsingRemoteVersion": "v0.8.35",
  "solidity.packageDefaultDependenciesDirectory": "node_modules",
  "solidity.packageDefaultDependenciesContractsDirectory": "",
  "solidity.monoRepoSupport": false,
  "solidity.formatter": "forge",

  "[solidity]": {
    "editor.defaultFormatter": "JuanBlanco.solidity",
    "editor.formatOnSave": false
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  }
}
